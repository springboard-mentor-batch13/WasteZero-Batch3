# ==========================================
# WasteZero — Root .gitignore
# Covers the full monorepo (Frontend + Backend)
# ==========================================

# ── Environment & Secrets (CRITICAL — never commit) ──────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# ── Dependency directories ────────────────────────────────────────────
node_modules/
.npm
.eslintcache

# ── Build artifacts ───────────────────────────────────────────────────
dist/
build/
out/
out-tsc/
bazel-out/

# ── Angular-specific ──────────────────────────────────────────────────
.angular/
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# ── IDE & editor files ────────────────────────────────────────────────
.idea/
.vscode/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ── OS-generated files ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
