# WasteZero Backend — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────
# Port the Express server listens on.
# Must match the Angular frontend's environment.ts apiUrl port (default: 5001).
PORT=5001
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────
# Full connection string (MongoDB Atlas or local MongoDB).
# Atlas example:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/wastezero
# Local example:   mongodb://localhost:27017/wastezero
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/wastezero

# ── JSON Web Token ────────────────────────────────────────────────────────
# MINIMUM 32 characters required. Server will refuse to start with a shorter secret.
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_min_32_chars_here
JWT_EXPIRES_IN=7d

# ── Pickup Scheduling Timezone ───────────────────────────────────────────
# Fixed UTC offset, in minutes, of the timezone that pickup time slots
# (preferredTimeSlot.start/end) are entered in. Used to correctly compute
# the "missed" cutoff for the pickup sweep.
# Examples: IST = 330, EST = -300. Defaults to host system timezone if unset.
# NOTE: this is a fixed offset — it does not account for daylight saving.
APP_TZ_OFFSET_MINUTES=

# ── OTP Configuration ─────────────────────────────────────────────────────
# OTP TTL is now enforced at the database layer via a MongoDB TTL index
# on the Otp collection (600 seconds = 10 minutes).
# OTP_EXPIRY is retained here for documentation purposes only.
OTP_EXPIRY=600000

# ── CORS ──────────────────────────────────────────────────────────────────
# Angular frontend origin — must match exactly (including port and protocol).
CLIENT_URL=http://localhost:4200

# ── SMTP / Email ──────────────────────────────────────────────────────────
# Generic SMTP settings (works with Gmail, SendGrid, Mailgun, SES, etc.)
# Gmail users: use an App Password (not your account password).
#   Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# The email address sending the OTPs
EMAIL=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# ── Cloudinary ────────────────────────────────────────────────────────────
# Cloudinary credentials for image upload and lifecycle management.
# Find these in your Cloudinary Dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Chat Encryption ───────────────────────────────────────────────────────
# AES-256-GCM symmetric key for encrypting messages and notifications at rest.
# Must be exactly 64 hexadecimal characters (32 bytes).
# Generate a fresh key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse this key across environments. NEVER commit the real value.
CHAT_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ── Admin Initialization (P0-04) ─────────────────────────────────────────
# One-time secret required to create the first admin account via:
#   POST /api/auth/admin/setup
# This endpoint verifies the submitted adminInitSecret against this value.
# Once an admin exists, the endpoint refuses further requests regardless of secret.
# MINIMUM 16 characters. Keep this secret out of version control.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_INIT_SECRET=<strong-random-secret-min-16-chars>
